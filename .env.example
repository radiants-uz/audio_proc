POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres


POSTGRES_BACKEND_USER=backend_user
POSTGRES_BACKEND_PASSWORD=12345
POSTGRES_BACKEND_DB=backend_db
POSTGRES_BACKEND_MIGRATOR_USER=backend_migrator
POSTGRES_BACKEND_MIGRATOR_PASSWORD=12345


REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=12345
REDIS_PROGRES_TTL=86400


BACKEND_ADMIN_USER=admin
BACKEND_ADMIN_PASSWORD=12345
BACKEND_ADMIN_API_KEY=12345
# Ключ подписи сессионной куки админки. Обязателен.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_ADMIN_SECRET_KEY=change-me-generate-a-random-32-byte-key


MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Host ports of the dev MinIO. 9000/9001 — ark-backend, 9100/9101 — doc-proc,
# so audio-proc takes 9200/9201 on a developer machine.
MINIO_HOST_PORT=9200
MINIO_CONSOLE_HOST_PORT=9201


S3_ENDPOINT_URL=http://minio:9000
# Схема и хост для presigned-ссылок клиенту (путь игнорируется, см. app/core/s3.py).
# Для внешнего S3 совпадает с S3_ENDPOINT_URL.
S3_EXTERNAL_URL=http://localhost:9200
# Prod на сервере — внешнее S3 вместо MinIO (MinIO в prod-compose не входит,
# см. docker-compose.minio.yml). Пример:
#   S3_ENDPOINT_URL=https://s3.s.glob.uz
#   S3_EXTERNAL_URL=https://s3.s.glob.uz
#   S3_USE_SSL=true
#   S3_ACCESS_KEY=<user>  S3_SECRET_KEY=<secret>
#   S3_STORAGE_BUCKET=<bucket>  S3_ASSETS_BUCKET=<bucket>  (бакет общий с ARK,
#   проект пишет только в свой префикс audio/)
S3_USE_SSL=false
S3_REGION=us-east-1
S3_ACCESS_KEY=minio_backend
S3_SECRET_KEY=strong_pass
S3_STORAGE_BUCKET=audio-processor
S3_ASSETS_BUCKET=audio-processor-assets
S3_EXPIRES_IN=86400

# Read-only пользователь MinIO для клиентов (см. .docker/minio/init_minio.sh)
S3_USER=minio_client
S3_USER_PASS=client_pass


# Одна задача на процесс воркера: модели диаризации/LID живут в памяти,
# параллельность — числом процессов (docker compose --scale backend-worker=N).
ARQ_MAX_WORKERS=1
ARQ_JOB_TIMEOUT=3600
ARQ_MAX_TRIES=1


CORS_ALLOW_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","OPTIONS"]
CORS_ALLOW_HEADERS=["Content-Type","Authorization","X-API-Key"]


BACKEND_MAX_FILE_SIZE_MB=500
# 8000 занят doc-proc на машине разработчика.
BACKEND_HOST_PORT=8100
# Prod-compose: nginx проекта слушает на хосте 127.0.0.1:NGINX_HTTP_HOST_PORT,
# хостовый nginx (:80) проксирует сюда запросы с префиксом API_ROOT_PATH.
NGINX_HTTP_HOST_PORT=8081
NGINX_BIND_ADDR=127.0.0.1
# Префикс публикации на хостовом nginx (http://<host>/audio-proc/docs). Пусто = с корня.
API_ROOT_PATH=/audio-proc

# Сборка образа: 1 — LibreOffice в образе (docx → pdf для отчётов). Без него
# операция report отдаёт только docx и пишет warning pdf_failed.
WITH_LIBREOFFICE=1


# ---------------------------------------------------------------------------
# Аудио-пайплайн
# ---------------------------------------------------------------------------
AUDIO_MAX_DURATION_SEC=7200
AUDIO_MIN_DURATION_SEC=1
AUDIO_TMP_DIR=/tmp/audio-proc
# cpu | cuda | mps
AUDIO_DEVICE=cpu
# Обязателен: диаризация pyannote/speaker-diarization-community-1 — gated-модель.
# Бесплатный аккаунт на huggingface.co → принять условия на странице модели →
# Settings → Access Tokens → токен с правом read.
AUDIO_HF_TOKEN=
AUDIO_KEEP_WAV=false

# pyannote (основной; нужен AUDIO_HF_TOKEN) | simple (только для разработки без токена:
# silero-VAD + ECAPA-эмбеддинги + кластеризация, не помечает наложения голосов).
DIARIZATION_BACKEND=pyannote
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_MIN_SPEAKERS=1
# Батчи pyannote (по умолчанию 32): меньше — меньше пик памяти на CPU.
DIARIZATION_SEGMENTATION_BATCH_SIZE=8
DIARIZATION_EMBEDDING_BATCH_SIZE=8
DIARIZATION_MAX_SPEAKERS=15
DIARIZATION_EMBEDDING_MODEL=speechbrain/spkrec-ecapa-voxceleb
DIARIZATION_CLUSTER_THRESHOLD=0.7
DIARIZATION_WINDOW_SEC=1.5
DIARIZATION_STEP_SEC=0.75

SEGMENTS_MERGE_GAP_SEC=0.5
SEGMENTS_MIN_SEGMENT_SEC=0.4
# ASR-API принимает куски до 30 с; 28 + паддинг укладывается.
SEGMENTS_MAX_SEGMENT_SEC=28.0
SEGMENTS_OVERLAP_MIN_SEC=0.3
SEGMENTS_PAD_SEC=0.15

LANGID_MODEL=speechbrain/lang-id-voxlingua107-ecapa
LANGID_ALLOWED=["uz","ru","en"]
LANGID_AUDIO_SEC=20
LANGID_MIN_AUDIO_SEC=2
LANGID_MIN_CONFIDENCE=0.6
LANGID_PER_SEGMENT_RECHECK=false
LANGID_RECHECK_MIN_SEGMENT_SEC=4.0
LANGID_RECHECK_MIN_CONFIDENCE=0.9

# Язык — на каждый кусок ASR (спикер может переключать языки). false = legacy «язык на спикера».
LANGID_CHUNK_LID=true
# Кусок ≥ CHUNK_MIN_SEC решает сам при уверенности ≥ CHUNK_MIN_CONFIDENCE (0 ошибок из 1782 окон при 0.9);
# короче — только при ≥ CHUNK_SHORT_CONFIDENCE, иначе наследует язык соседей того же спикера.
LANGID_CHUNK_MIN_CONFIDENCE=0.90
LANGID_CHUNK_MIN_SEC=2.0
LANGID_CHUNK_SHORT_CONFIDENCE=0.98
# Короткий кусок против всех решённых соседей спикера решает сам только при уверенности ≥
LANGID_CHUNK_SHORT_AGAINST_CONFIDENCE=0.995
LANGID_CHUNK_LID_MIN_SEC=1.0
LANGID_NEIGHBOUR_MAX_GAP_SEC=30
LANGID_PRIOR_MIN_SEC=2.0
# LID по исходному сигналу (замеры сделаны на нём), не после шумодава.
LANGID_ON_RAW_AUDIO=true

# remote | mock. mock — для разработки, когда ASR-API заказчика недоступен.
ASR_BACKEND=remote
ASR_API_URL=https://stt.robot-guide.iccu.uz/api/v1/asr/transcribe
ASR_FILE_FIELD=file
ASR_LANG_FIELD=language_code
ASR_TEXT_FIELD=transcription
ASR_CONCURRENCY=4
ASR_TIMEOUT_SEC=60
ASR_RETRIES=3
# Языки, которые реально обслуживает ASR-бэкенд (маршрутизация и повторы = LANGID_ALLOWED ∩ ASR_LANGUAGES).
ASR_LANGUAGES=["uz","ru","en"]
# Проверка текста ASR на «не тот язык» (символьные n-граммы, textcheck.py) с повтором другим языком.
# Русская речь через узбекскую модель возвращается транслитерацией, а не пустотой — только так её и поймать.
ASR_TEXT_CHECK=true
ASR_TEXT_CHECK_MIN_TOKENS=3
ASR_TEXT_CHECK_MIN_CPS=4.0
# Правило плотности применяется только к кускам не короче этого (с).
ASR_TEXT_CHECK_DENSITY_MIN_SEC=2.0
ASR_RETRY_LANGS_MAX=2
# Кусок для ASR: сегменты режутся до ≤ N с в тихих точках (на дальних записях модель
# на длинных кусках молчит; 8 с дало 21/40 сегментов с текстом против 13/40 при 28 с).
ASR_MAX_CHUNK_SEC=8
# Резать куски по речи (silero-VAD, паддинг 0.3 с), а не фиксированным шагом: 18/40 против 12/40 сегментов с текстом.
ASR_VAD_CHUNKS=true
ASR_VAD_PAD_SEC=0.3
# Пустой кусок повторять на других языках файла (uz/ru/en).
ASR_FALLBACK_LANGS=true
# Пустой кусок после нейрошумодава повторять на исходном сигнале (шумодав может срезать тихую речь).
ASR_RAW_FALLBACK=true

# LLM-сервисы (GLM-5.3) заводятся в /admin → Services. Здесь — лимиты по умолчанию.
# Контекст локально поднятой GLM-5.3 — 120k токенов.
ANALYSIS_MAX_INPUT_TOKENS=40000
ANALYSIS_CHUNK_TOKENS=30000
ANALYSIS_MAX_OUTPUT_TOKENS=8000
ANALYSIS_TIMEOUT_SEC=300
ANALYSIS_RETRIES=3
# auto = язык спикера с наибольшим временем речи
ANALYSIS_DEFAULT_REPORT_LANG=auto

# Адаптивное улучшение звука перед ASR/LID (диаризация — по исходному сигналу):
# тихая запись (mean ниже ENHANCE_QUIET_DB) → speechnorm; шумная (noise floor выше
# ENHANCE_NOISY_DB) → afftdn. Чистые громкие записи не трогаются.
ENHANCE_ENABLED=true
ENHANCE_QUIET_DB=-28
ENHANCE_NOISY_DB=-45
ENHANCE_DENOISE_NR=12
ENHANCE_DENOISE_NF=-35
ENHANCE_SPEECHNORM_EXPANSION=6
# Нейрошумодав DeepFilterNet3 (грузится в воркере): none | deepfilter.
# На дальних/тихих записях поднимает распознавание с нуля; на CPU ≈ 40× быстрее реального времени.
ENHANCE_NEURAL=deepfilter
# DeepFilterNet считает файл окнами (с) с перекрытием — иначе длинная запись выедает память воркера.
ENHANCE_DEEPFILTER_CHUNK_SEC=30
ENHANCE_DEEPFILTER_OVERLAP_SEC=1.0

# Слияние ложных спикеров после диаризации по ECAPA-эмбеддингам: спикер с речью
# короче MIN_SPEECH_SEC или долей меньше MIN_SHARE сливается с ближайшим по голосу;
# пары с косинусной близостью выше MERGE_SIMILARITY сливаются; expected_speakers
# из запроса сжимает до точного числа.
SPEAKERS_ENABLED=true
SPEAKERS_MIN_SPEECH_SEC=6
SPEAKERS_MIN_SHARE=0.03
SPEAKERS_MERGE_SIMILARITY=0.80
# Для DIARIZATION_BACKEND=simple: его обрывки одного голоса похожи на 0.5–0.7, чужой голос — до 0.35.
SPEAKERS_MERGE_SIMILARITY_SIMPLE=0.55

REPORT_LIBREOFFICE_BIN=soffice
REPORT_INCLUDE_FULL_TRANSCRIPT=true
