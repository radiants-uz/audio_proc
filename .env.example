POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres


POSTGRES_BACKEND_USER=backend_user
POSTGRES_BACKEND_PASSWORD=12345
POSTGRES_BACKEND_DB=backend_db
POSTGRES_BACKEND_MIGRATOR_USER=backend_migrator
POSTGRES_BACKEND_MIGRATOR_PASSWORD=12345


REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=12345
REDIS_PROGRES_TTL=86400


BACKEND_ADMIN_USER=admin
BACKEND_ADMIN_PASSWORD=12345
BACKEND_ADMIN_API_KEY=12345
# Ключ подписи сессионной куки админки. Обязателен.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKEND_ADMIN_SECRET_KEY=change-me-generate-a-random-32-byte-key


MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Host ports of the dev MinIO. 9000/9001 — ark-backend, 9100/9101 — doc-proc,
# so audio-proc takes 9200/9201 on a developer machine.
MINIO_HOST_PORT=9200
MINIO_CONSOLE_HOST_PORT=9201


S3_ENDPOINT_URL=http://minio:9000
S3_EXTERNAL_URL=http://localhost:9200
S3_USE_SSL=false
S3_REGION=us-east-1
S3_ACCESS_KEY=minio_backend
S3_SECRET_KEY=strong_pass
S3_STORAGE_BUCKET=audio-processor
S3_ASSETS_BUCKET=audio-processor-assets
S3_EXPIRES_IN=86400

# Read-only пользователь MinIO для клиентов (см. .docker/minio/init_minio.sh)
S3_USER=minio_client
S3_USER_PASS=client_pass


# Одна задача на процесс воркера: модели диаризации/LID живут в памяти,
# параллельность — числом процессов (docker compose --scale backend-worker=N).
ARQ_MAX_WORKERS=1
ARQ_JOB_TIMEOUT=3600
ARQ_MAX_TRIES=1


CORS_ALLOW_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","OPTIONS"]
CORS_ALLOW_HEADERS=["Content-Type","Authorization","X-API-Key"]


BACKEND_MAX_FILE_SIZE_MB=500
# 8000 занят doc-proc на машине разработчика.
BACKEND_HOST_PORT=8100
# Порты nginx на хосте (только prod-compose); внешний reverse-proxy ходит на 80
NGINX_HTTP_HOST_PORT=80
NGINX_HTTPS_HOST_PORT=443

# Сборка образа: 1 — LibreOffice в образе (docx → pdf для отчётов). Без него
# операция report отдаёт только docx и пишет warning pdf_failed.
WITH_LIBREOFFICE=1


# ---------------------------------------------------------------------------
# Аудио-пайплайн
# ---------------------------------------------------------------------------
AUDIO_MAX_DURATION_SEC=7200
AUDIO_MIN_DURATION_SEC=1
AUDIO_TMP_DIR=/tmp/audio-proc
# cpu | cuda | mps
AUDIO_DEVICE=cpu
# Нужен только для DIARIZATION_BACKEND=pyannote (gated-модель на Hugging Face).
AUDIO_HF_TOKEN=
AUDIO_KEEP_WAV=false

# pyannote | simple. simple — без HF-токена: silero-VAD + ECAPA-эмбеддинги + кластеризация.
DIARIZATION_BACKEND=simple
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_MIN_SPEAKERS=1
DIARIZATION_MAX_SPEAKERS=15
DIARIZATION_EMBEDDING_MODEL=speechbrain/spkrec-ecapa-voxceleb
DIARIZATION_CLUSTER_THRESHOLD=0.7
DIARIZATION_WINDOW_SEC=1.5
DIARIZATION_STEP_SEC=0.75

SEGMENTS_MERGE_GAP_SEC=0.5
SEGMENTS_MIN_SEGMENT_SEC=0.4
# ASR-API принимает куски до 30 с; 28 + паддинг укладывается.
SEGMENTS_MAX_SEGMENT_SEC=28.0
SEGMENTS_OVERLAP_MIN_SEC=0.3
SEGMENTS_PAD_SEC=0.15

LANGID_MODEL=speechbrain/lang-id-voxlingua107-ecapa
LANGID_ALLOWED=["uz","ru","en"]
LANGID_AUDIO_SEC=20
LANGID_MIN_AUDIO_SEC=2
LANGID_MIN_CONFIDENCE=0.6
LANGID_PER_SEGMENT_RECHECK=false
LANGID_RECHECK_MIN_SEGMENT_SEC=4.0
LANGID_RECHECK_MIN_CONFIDENCE=0.9

# remote | mock. mock — для разработки, когда ASR-API заказчика недоступен.
ASR_BACKEND=remote
ASR_API_URL=https://stt.robot-guide.iccu.uz/api/v1/asr/transcribe
ASR_FILE_FIELD=file
ASR_LANG_FIELD=language_code
ASR_TEXT_FIELD=transcription
ASR_CONCURRENCY=4
ASR_TIMEOUT_SEC=60
ASR_RETRIES=3

# LLM-сервисы (GLM-5.3) заводятся в /admin → Services. Здесь — лимиты по умолчанию.
# Контекст локально поднятой GLM-5.3 — 120k токенов.
ANALYSIS_MAX_INPUT_TOKENS=40000
ANALYSIS_CHUNK_TOKENS=30000
ANALYSIS_MAX_OUTPUT_TOKENS=8000
ANALYSIS_TIMEOUT_SEC=300
ANALYSIS_RETRIES=3
# auto = язык спикера с наибольшим временем речи
ANALYSIS_DEFAULT_REPORT_LANG=auto

REPORT_LIBREOFFICE_BIN=soffice
REPORT_INCLUDE_FULL_TRANSCRIPT=true
